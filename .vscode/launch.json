    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--output=/tmp/000",
                "--tag=bibles",
                "--env=qa"
            ],
            "env": {
                "METERIAN_API_TOKEN": "89a20657-e2b1-4b33-b801-abac8d1de050"
            }        
        }
    ]
}